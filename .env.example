# =============================================================================
# ResuBoost AI - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=ResuBoost AI
APP_VERSION=2.0.0
DEBUG=false

# -----------------------------------------------------------------------------
# Database - Neon PostgreSQL (Required)
# Get your connection string from https://console.neon.tech
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/resuboost?sslmode=require
# Pool settings for Neon's connection pooler
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# -----------------------------------------------------------------------------
# Redis - Upstash or Railway Redis (Required for production)
# Get your Redis URL from https://console.upstash.com
# -----------------------------------------------------------------------------
REDIS_URL=redis://default:password@xxx.upstash.io:6379

# -----------------------------------------------------------------------------
# Authentication - Clerk (Required)
# Get your keys from https://dashboard.clerk.com
# -----------------------------------------------------------------------------
CLERK_SECRET_KEY=sk_live_xxxxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# -----------------------------------------------------------------------------
# LLM Provider (Required - choose one)
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
# Options: openai, anthropic, google, ollama, mock

# OpenAI
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# Google (Gemini)
# GOOGLE_API_KEY=xxxxx
# GOOGLE_MODEL=gemini-1.5-flash

# Ollama (local development only)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# -----------------------------------------------------------------------------
# Error Monitoring - Sentry (Recommended)
# Get your DSN from https://sentry.io
# -----------------------------------------------------------------------------
SENTRY_DSN=https://xxxxx@o123.ingest.sentry.io/123
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@o123.ingest.sentry.io/123

# -----------------------------------------------------------------------------
# CORS & Security
# -----------------------------------------------------------------------------
CORS_ORIGINS=["https://your-app.vercel.app"]
SECRET_KEY=generate-a-secure-random-key-here
COOKIE_SECURE=true
COOKIE_DOMAIN=.your-domain.com

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
AUTH_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_REQUESTS=20

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://your-backend.railway.app

# -----------------------------------------------------------------------------
# Job Discovery (Optional)
# -----------------------------------------------------------------------------
# ADZUNA_APP_ID=xxxxx
# ADZUNA_API_KEY=xxxxx
