# ResuBoost AI Frontend Configuration
# Copy this file to .env.local and customize as needed
# cp .env.example .env.local

# =============================================================================
# BACKEND API
# =============================================================================

# Backend API URL (FastAPI server)
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# DEMO / DEVELOPMENT
# =============================================================================

# Show demo credentials on login page (set to 'true' to enable)
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true

# Demo account credentials (only used when SHOW_DEMO_CREDENTIALS is true)
# NEXT_PUBLIC_DEMO_USERNAME=demo
# NEXT_PUBLIC_DEMO_PASSWORD=demo1234

# =============================================================================
# CDN & ASSETS (Production only)
# =============================================================================

# CDN base URL for serving static assets (e.g., https://cdn.example.com)
# Leave empty for local/self-hosted serving
# NEXT_PUBLIC_CDN_URL=

# Asset prefix override (defaults to CDN_URL if set)
# NEXT_PUBLIC_ASSET_PREFIX=

# Additional image domains for next/image optimization (comma-separated)
# NEXT_PUBLIC_IMAGE_DOMAINS=

# =============================================================================
# WEB VITALS & ANALYTICS (Optional)
# =============================================================================

# Enable Web Vitals tracking (defaults to true in production)
# NEXT_PUBLIC_ENABLE_WEB_VITALS=true

# Custom endpoint for Web Vitals beacon data
# NEXT_PUBLIC_WEB_VITALS_ENDPOINT=
